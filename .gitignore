# Build output e stato dell'IDE. In build/ finisce tutto quello che genera CMake,
# inclusi la solution e il .vcxproj: sono artefatti, non sorgenti.
.vs/
build/
ipch/
*.user
*.aps
*.VC.db
*.VC.opendb
*.sarif

# Sottoprodotti del linker che non servono a chi consuma una libreria: .ilk e'
# lo stato del link incrementale, valido solo sulla macchina che l'ha prodotto;
# .exp serve solo quando exe e DLL hanno dipendenze di export circolari, che qui
# non esistono. Restano su disco dentro third_party/, ma fuori dal repository.
*.ilk
*.exp

# Della distribuzione libmicrohttpd in third_party/ si versiona solo la variante
# contro cui questo progetto linka: win64, layout VS2019 (consumato dal toolset
# v143 di VS2022). Le varianti x86, MinGW e VS2017 restano sul disco ma fuori
# dal repository: il perimetro supportato e' solo win64.
/third_party/libmicrohttpd-0.9.73-w32-bin/*
!/third_party/libmicrohttpd-0.9.73-w32-bin/x86_64/
/third_party/libmicrohttpd-0.9.73-w32-bin/x86_64/*
!/third_party/libmicrohttpd-0.9.73-w32-bin/x86_64/VS2019/
